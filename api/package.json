{
  "name": "ctfnote-api",
  "version": "1.0.0",
  "description": "GraphQL API for CTFNotes",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "start": "NODE_ENV=production node dist/index.js",
    "build": "tsc",
    "lint": "eslint --fix 'src/**/*.ts'",
    "format": "prettier --config ../.prettierrc --write 'src/**/*.ts'",
    "dev": "DEBUG=postgraphile:postgres:error NODE_ENV=development nodemon src/index.ts",
    "dev:migrate": "DATABASE_URL= yarn run db-migrate -e dev up",
    "test:security": "node --test test/dependencies.cjs",
    "test:integration": "node --test test/integration.cjs"
  },
  "lint-staged": {
    "src/**/*.{ts,css,html,vue}": [
      "yarn run prettier --config ../.prettierrc --write"
    ]
  },
  "dependencies": {
    "@graphile-contrib/pg-many-to-many": "^1.0.2",
    "@graphile-contrib/pg-simplify-inflector": "^6.1.0",
    "@graphile/operation-hooks": "^1.0.0",
    "@graphile/pg-pubsub": "4.14.1",
    "axios": "^1.20.0",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "graphile-utils": "4.14.1",
    "graphql": "^15.10.2",
    "graphql-upload-ts": "^2.2.0",
    "ical-generator": "^7.0.0",
    "postgraphile": "4.14.1",
    "postgraphile-plugin-connection-filter": "^2.3.0",
    "postgres-migrations": "^5.3.0",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "lint-staged": "^15.2.2",
    "nodemon": "^3.1.7",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "packageManager": "yarn@4.1.1",
  "resolutions": {
    "undici": "^6.28.1",
    "minimatch@npm:9.0.3": "^9.0.7"
  },
  "engines": {
    "node": ">=22"
  }
}
